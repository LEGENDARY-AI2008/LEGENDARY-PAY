# ---- required ----
DATABASE_URL=postgres://user:pass@host:5432/wallet
PGSSL=0
JWT_SECRET=change-me-long-random
ADMIN_KEY=change-me-admin-key
RUN_WORKER=1
# Your frontend address (Vercel URL). Comma-separate several. Empty = allow all (testing only).
ALLOWED_ORIGIN=

# ---- testing mode: 1 = fake money flows allowed. MUST be 0 when real money is live ----
SANDBOX=1

# ---- Flutterwave (dashboard > Settings > API keys; webhook hash under Settings > Webhooks) ----
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# ---- email for PIN reset (fill later; empty = codes print in the server log) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- alerts to your Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
